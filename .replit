# Development preview only. This is not a production deployment configuration.
# Database-backed development requires the setup in docs/REPLIT.md.
run = "npm run dev --workspace=apps/web -- --hostname 0.0.0.0"
onBoot = "npm ci && npm run build:signals"
language = "javascript"
entrypoint = "apps/web/app/page.tsx"

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 3000
externalPort = 80

[env]
NEXT_TELEMETRY_DISABLED = "1"
