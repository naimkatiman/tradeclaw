{
  "name": "tradeclaw",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, self-hostable trading research and agent platform.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=packages/signals && npm run build --workspace=packages/trading-agents && npm run build --workspace=apps/web",
    "build:signals": "npm run build --workspace=packages/signals",
    "typecheck:web": "npm run build:signals && tsc --noEmit --project apps/web/tsconfig.json",
    "build:trading-agents": "npm run build --workspace=packages/trading-agents",
    "build:agent": "npm run build --workspace=packages/agent",
    "build:all": "npm run build:signals && npm run build:agent && npm run build && npm run ws:build",
    "lint": "npm run lint --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "agent": "npx tsx packages/agent/src/cli/cli.ts",
    "agent:start": "npx tsx packages/agent/src/cli/cli.ts start",
    "agent:scan": "npx tsx packages/agent/src/cli/cli.ts scan",
    "agent:server": "npx tsx packages/agent/src/server/server.ts",
    "ws:dev": "npm run dev --workspace=apps/ws-server",
    "ws:build": "npm run build --workspace=apps/ws-server",
    "ws:start": "npm run start --workspace=apps/ws-server",
    "ws:test": "npm run test --workspace=apps/ws-server",
    "resolve:outcomes": "npx tsx -e \"import { resolveRealOutcomes } from './apps/web/lib/signal-history.ts'; resolveRealOutcomes().then(() => console.log('Done')).catch(e => { console.error(e); process.exit(1); })\"",
    "verify:research-intake": "node scripts/research/verify-systematic-intake-source.mjs",
    "verify:research-review": "npx tsx scripts/research/verify-marketing-review-evidence.ts",
    "validate:research-review-handoff": "npx tsx scripts/research/validate-marketing-review-handoff.ts",
    "prepare:research-owner-decision-request": "npx tsx scripts/research/prepare-marketing-owner-decision-request.ts",
    "prepare:research-owner-decision-template": "npx tsx scripts/research/prepare-marketing-owner-decision-template.ts",
    "validate:research-owner-decision": "npx tsx scripts/research/validate-marketing-owner-decision.ts",
    "research:prepare-bitcoin-seasonality": "node scripts/research/prepare-bitcoin-seasonality-inputs.mjs",
    "research:prepare-trading-term-premium": "node scripts/research/prepare-trading-term-premium-input.mjs",
    "research:bitcoin-max-min": "npx tsx scripts/research/bitcoin-max-min-replication.ts",
    "research:end-of-month-treasury": "npx tsx scripts/research/end-of-month-treasury-replication.ts",
    "research:trading-term-premium": "npx tsx scripts/research/trading-term-premium-replication.ts",
    "test": "jest",
    "test:e2e": "npm run test:e2e --workspace=apps/web"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/naimkatiman/tradeclaw.git"
  },
  "keywords": [
    "trading",
    "ai",
    "signals",
    "self-hosted",
    "open-source",
    "technical-analysis"
  ],
  "author": "Naim Katiman",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "yaml": "^2.8.3"
  }
}
